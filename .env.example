# Copy to backend/.env (never commit real values). All values below are placeholders.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of trusted reverse proxies in front of the API (needed for correct client IPs / rate limits).
TRUST_PROXY=0

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/drivecopy

# --- Sessions ---
# At least 32 random characters, e.g. `openssl rand -base64 48`. Rotating it signs everyone out of CSRF tokens.
SESSION_SECRET=
SESSION_TTL_HOURS=168
# Exact origin of the web app. Used for CORS and the CSRF origin check. Must be https in production.
FRONTEND_URL=http://localhost:5173

# --- Login ---
# The single authorized login. There is no public registration. Change these any time and restart
# the backend: the new values apply and every existing session is signed out.
# The password needs at least 12 characters. Wrap it in quotes if it contains # or spaces.
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD=CHANGE_THIS_PASSWORD

# --- Amazon S3 ---
AWS_REGION=
AWS_S3_BUCKET=
# Leave both empty in production and use an IAM role (ECS task role, EC2 instance profile, etc.).
# Never put AWS credentials in frontend/.env or any VITE_ variable.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: S3-compatible endpoint for local development (e.g. MinIO). Leave empty for AWS.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# --- Limits ---
MAX_FILE_SIZE_MB=5120
MULTIPART_THRESHOLD_MB=64
MULTIPART_PART_SIZE_MB=16
PRESIGNED_URL_TTL_SECONDS=900
UPLOAD_SESSION_TTL_MINUTES=1440
# How often the API cleans up expired uploads, retries purges and aborts orphaned multipart uploads (0 = off).
CLEANUP_INTERVAL_MINUTES=15
# How often the bucket is fully listed to verify the storage figures (0 = only when none exist yet).
STORAGE_STATS_REFRESH_MINUTES=60
# How often pending activity events are written to S3 under activity-logs/.
ACTIVITY_FLUSH_SECONDS=5
